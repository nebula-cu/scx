@@ -6016,9 +6016,19 @@ __pick_next_task(struct rq *rq, struct task_struct *prev, struct rq_flags *rf)
 	struct task_struct *p;
 
 	rq->dl_server = NULL;
-
-	if (scx_enabled())
-		goto restart;
+	
+	if (scx_enabled()){
+		if(likely(!sched_class_above(prev->sched_class, &ext_sched_class) && rq->nr_running == rq->scx.nr_running)){
+			rq->scx.flags |= SCX_RQ_BAL_PENDING;
+			ext_sched_class.balance(rq, prev, rf);
+			p = ext_sched_class.pick_task(rq);
+			if (p){
+				put_prev_set_next_task(rq, prev, p);
+				return p;
+			}
+			goto restart;
+		}
+	}
 
